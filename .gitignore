# свои настройки: пути к папкам и адрес сервера у каждого свои, а правки
# в файле из репозитория превращали бы каждое обновление в конфликт.
# Образец — config.example.yaml
config.yaml

# секреты — здесь их быть не должно вовсе
.env
# И тот, что рядом со сборкой Langfuse: в нём пароли от баз.
deploy/langfuse/.env
*token*.txt

# свой справочник направлений: у каждого он свой — регионы, площадки,
# дочерние общества, — и в общий репозиторий ему не место.
# Образец — examples/справочник.csv
/справочник.csv
data/справочник*.csv
data/слова*.csv
data/участники*.csv
data/форма*.md

# контрольные ВКС: на каждое заседание папка с датой, а в ней всё об этом
# совещании — протокол за подписью, стенограмма, прогоны приложения. По ним
# меряется качество разбора, и без них его не проверить — но это документы
# закрытых совещаний с настоящими ФИО. Раскладка: data/vks/КАК УСТРОЕНО.md
#
# Запрет намеренно стоит на всём data/, а не на именах папок: репозиторий
# публичный, и правило вида «data/вкс/» молча перестаёт защищать, стоит папку
# переименовать. Отслеживаются только образцы в data/sample.
/data/*
!/data/sample/

# данные и результаты: записи совещаний в репозиторий не попадают никогда
data/work/
data/input/
data/output/
*.wav
*.mp4
*.mkv
logs/
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage

# ОС и IDE
.DS_Store
.idea/
.vscode/
