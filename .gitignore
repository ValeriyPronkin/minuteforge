# свои настройки: пути к папкам и адрес сервера у каждого свои, а правки
# в файле из репозитория превращали бы каждое обновление в конфликт.
# Образец — config.example.yaml
config.yaml

# секреты — здесь их быть не должно вовсе
.env
*token*.txt

# свой справочник направлений: у каждого он свой — регионы, площадки,
# дочерние общества, — и в общий репозиторий ему не место.
# Образец — examples/справочник.csv
/справочник.csv
data/справочник*.csv

# эталоны: настоящие протоколы за подписью и разобранные вручную поручения.
# По ним меряется качество разбора, и без них его не проверить — но это
# документы закрытых совещаний с настоящими ФИО. Складываются по дате ВКС:
# data/эталоны/2026-08-27/
data/эталоны/

# данные и результаты: записи совещаний в репозиторий не попадают никогда
data/work/
data/input/
data/output/
*.wav
*.mp4
*.mkv
logs/
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage

# ОС и IDE
.DS_Store
.idea/
.vscode/
