# Образец. Скопируйте в .env рядом и заполните — свой файл в репозиторий не
# идёт: в нём пароли.
#
#   cp .env.example .env
#
# Три секрета внизу выдумывать не нужно, они делаются командой — каждый свой,
# одинаковыми их ставить нельзя.

# --- Postgres: ваш, уже поднятый --------------------------------------------
# База «langfuse» должна существовать до первого запуска: схему приложение
# создаст само, а базу нет.
#
#   createdb -h сервер -U postgres langfuse
#
DATABASE_URL=postgresql://пользователь:пароль@сервер-postgres:5432/langfuse

# --- Адрес интерфейса -------------------------------------------------------
# Тот, по которому Langfuse открывают из сети организации. Именно сетевой, а
# не localhost: по localhost он откроется только на самом сервере, а переходы
# после входа сломаются.
LANGFUSE_URL=http://сервер-приложений:3000

# --- Хранилище объектов -----------------------------------------------------
# По умолчанию — свой minio из compose-файла, и тогда адрес менять не надо,
# достаточно придумать ключ и секрет.
#
# Если отдаёте это своему хранилищу — поставьте его адрес и ключи, а службу
# minio из compose-файла уберите.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=langfuse
S3_ACCESS_KEY=придумайте-ключ
S3_SECRET_KEY=придумайте-длинный-секрет

# --- Пароли внутренних служб ------------------------------------------------
# Наружу они не смотрят, но пусть будут длинными: контур внутренний, а трассы
# держат содержание совещаний.
CLICKHOUSE_PASSWORD=длинный-пароль-clickhouse
REDIS_PASSWORD=длинный-пароль-redis

# --- Секреты самого Langfuse ------------------------------------------------
# Делаются командами, каждый свой:
#
#   openssl rand -hex 32     -> ENCRYPTION_KEY (ровно 64 знака)
#   openssl rand -base64 32  -> NEXTAUTH_SECRET
#   openssl rand -base64 24  -> SALT
#
# На Windows без openssl то же самое даёт PowerShell:
#
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
#
# ENCRYPTION_KEY менять после первого запуска нельзя: им зашифровано то, что
# уже лежит в базе.
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
SALT=
